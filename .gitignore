# Local Netlify folder
.netlify

# Dependencies
node_modules/

# macOS
.DS_Store

# Claude Code
# Ignore .claude contents EXCEPT skills/ — cloud routines need project skills
# tracked to discover them. Must be `.claude/*`, not `.claude/`: git will not
# descend into an excluded directory, so a negation under it never fires.
.claude/*
!.claude/skills/
# No trailing slash: .claude/agents is a symlink, and git treats symlinks as
# files — a trailing-slash pattern matches directories only and would miss it.
!.claude/agents

# Temp files
temporary screenshots/
*.tmp

# Python bytecode (vendored seo-audit scripts)
__pycache__/
*.pyc

# Local-only credentials — never commit. This repo is public on GitHub.
ops/OPS-LOGINS.md

# Claude Design working files: the .dc.html artboards and canvas.json are the
# source and are kept, the seeded canvas is a ~2MB build artifact and is not.
.design-pickup/*.html
!.design-pickup/*.dc.html

# seo-audit skill working output. The skill writes findings to `{domain}-audit/`,
# but the repo root IS the Netlify publish directory, so anything left here is
# served publicly. The findings that matter are committed under
# SEO/GSC-Analysis/<date>-findings/ instead, which carries a noindex header.
# Anchored with a leading slash so it matches ONLY the repo root. Unanchored,
# `*-audit/` also matches skills/seo-audit/, which is a tracked, byte-for-byte
# vendored copy of the claude-seo plugin and must never be excluded.
/*-audit/
